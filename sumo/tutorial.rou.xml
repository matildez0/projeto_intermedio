<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Tipo base -->
    <vType id="car"
           accel="2.6"
           decel="4.5"
           sigma="0.5"
           length="5.0"
           minGap="2.5"
           maxSpeed="19.44"
           guiShape="passenger" />

    <!-- Corredor principal horizontal (oeste -> este), passando na zona de obras -->
    <route id="main_west_east" edges="E_W0 E_W1 E_WORK E_E1 E_E2"/>

    <!-- Sentido contrário -->
    <route id="main_east_west" edges="E_E2_rev E_E1_rev E_WORK_rev E_W1_rev E_W0_rev"/>

    <!-- Fluxos verticais -->
    <route id="north_south_1" edges="E_N0 E_N1 E_N2"/>
    <route id="south_north_1" edges="E_S2_rev E_S1_rev E_S0_rev"/>

    <route id="north_south_2" edges="E_N3 E_N4 E_N5"/>
    <route id="south_north_2" edges="E_S5_rev E_S4_rev E_S3_rev"/>

    <!-- Fluxo principal: este é o que deve saturar o gargalo -->
    <flow id="flow_main_1"
          type="car"
          route="main_west_east"
          begin="0"
          end="3600"
          vehsPerHour="1800"
          departLane="best"
          departSpeed="max" />

    <!-- Fluxo contrário moderado -->
    <flow id="flow_main_2"
          type="car"
          route="main_east_west"
          begin="0"
          end="3600"
          vehsPerHour="900"
          departLane="best"
          departSpeed="max" />

    <!-- Tráfego cruzado -->
    <flow id="flow_ns_1"
          type="car"
          route="north_south_1"
          begin="0"
          end="3600"
          vehsPerHour="650"
          departLane="best"
          departSpeed="max" />

    <flow id="flow_sn_1"
          type="car"
          route="south_north_1"
          begin="0"
          end="3600"
          vehsPerHour="650"
          departLane="best"
          departSpeed="max" />

    <flow id="flow_ns_2"
          type="car"
          route="north_south_2"
          begin="0"
          end="3600"
          vehsPerHour="500"
          departLane="best"
          departSpeed="max" />

    <flow id="flow_sn_2"
          type="car"
          route="south_north_2"
          begin="0"
          end="3600"
          vehsPerHour="500"
          departLane="best"
          departSpeed="max" />

</routes>